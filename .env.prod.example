# Kachu+ Production 環境變數範本
# 複製本檔為 .env.prod 並填入實際值後，上傳至 /opt/kachu-plus/.env.prod
#
# DATABASE_URL、AGENTOS_BASE_URL、KACHU_BASE_URL 不需要在此設定，
# 由 docker-compose.prod.yml 的 environment 區塊覆蓋注入。

# ── Postgres ──────────────────────────────────────────────────────────────────
# docker-compose 用來建立 postgres 容器的密碼，需與 DATABASE_URL 中密碼一致
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── 欄位加密（Fernet key） ────────────────────────────────────────────────────
# 用來加密 DB 中的 channel_secret / channel_access_token
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── Admin API ─────────────────────────────────────────────────────────────────
# 呼叫 POST /admin/tenants 等管理端點時需要的 Bearer token
# 產生方式：openssl rand -hex 32
ADMIN_API_TOKEN=REPLACE_WITH_ADMIN_TOKEN

# ── LLM ───────────────────────────────────────────────────────────────────────
# photo analyze / FAQ / 顧問回覆都會優先使用這組 LLM provider
GOOGLE_AI_API_KEY=REPLACE_WITH_GOOGLE_AI_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY       # 選填；Gemini 為主時可留空
LITELLM_MODEL=gemini/gemini-2.0-flash
CONSULTANT_LLM_MODEL=gemini/gemini-2.0-flash

# ── Google Business Profile（OAuth） ──────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
# Service Account JSON（若使用 SA 驗證，否則留空）
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Meta OAuth（Facebook / Instagram） ───────────────────────────────────────
# Meta App 後台需將 redirect URI 加入 allowlist，正式值應對應 plus.kachu.tw
META_APP_ID=REPLACE_WITH_META_APP_ID
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_META_WEBHOOK_VERIFY_TOKEN
META_OAUTH_REDIRECT_URI=https://plus.kachu.tw/meta/oauth/callback
# 若未特別調整權限範圍，可直接沿用預設值
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# ── Tenant 級憑證（不放 .env，由 Admin API / connector 寫入 DB） ─────────────
# LINE：line_channel_id / line_channel_secret / line_channel_access_token
# Google Business：account_id / location_id / access_token / refresh_token(建議)
# Meta：access_token / fb_page_id / ig_user_id / fb_access_token(選填)

# ── 顧客沉睡同步排程 ──────────────────────────────────────────────────────────
SLEEP_SYNC_ENABLED=true
SLEEP_SYNC_RUN_ON_STARTUP=true
SLEEP_SYNC_INTERVAL_SECONDS=86400
